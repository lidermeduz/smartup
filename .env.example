# ┌─────────────────────────────────────────────────────────────┐
# │ .env — HAQIQIY PAROLLAR VA KODLAR SHU YERGA                  │
# │ Nusxalang:  cp .env.example .env  va quyidagilarni to'ldiring │
# │ DIQQAT: bu faylni hech kimga bermang, git'ga qo'shmang!      │
# └─────────────────────────────────────────────────────────────┘

# ── Smartup API ──
SMARTUP_BASE_URL=https://smartup.online
# Uchchala kompaniya bitta hisobda — project_code bitta:
SMARTUP_PROJECT_CODE=pfl
SMARTUP_USERNAME=
SMARTUP_PASSWORD=

# ── Telegram bot ──
TELEGRAM_BOT_TOKEN=

# ── Filtrlar ──
# Status kodlari (Smartup UI): B#N = Новый, B#W = В ожидании, B#S = Отгружен.
# Bir nechtasi: vergul bilan  a,b,c
TARGET_STATUSES=B#W
# "Терминал" omborining KOD(lar)i (nom emas!). Shu ombordagi orderlar
# umuman yuborilmaydi. Bo'sh = filtrlanmaydi:
EXCLUDE_WAREHOUSE_CODES=

# Tekshirish oralig'i (sekund). 600 = har 10 daqiqa
POLL_INTERVAL_SECONDS=600

# ── Kompaniyalar ──
# Order javobidagi filial_id + subfilial_code bo'yicha ajratiladi
# (Smartup UI'dagi "Проект" ustuniga mos keladi).

# ── Gynomedix (alohida filial) ──
GYNOMEDIX_FILIAL_ID=18004635
GYNOMEDIX_SUBFILIAL_CODE=
GYNOMEDIX_CHAT_ID=

# ── BP Pharma (filial 17986720, subfilial 59591) ──
BP_PHARMA_FILIAL_ID=17986720
BP_PHARMA_SUBFILIAL_CODE=59591
BP_PHARMA_CHAT_ID=

# ── Bromedix (filial 17986720, subfilial 59592) ──
BROMEDIX_FILIAL_ID=17986720
BROMEDIX_SUBFILIAL_CODE=59592
BROMEDIX_CHAT_ID=
