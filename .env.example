# ┌─────────────────────────────────────────────────────────────┐
# │ .env — HAQIQIY PAROLLAR VA KODLAR SHU YERGA                  │
# │ Nusxalang:  cp .env.example .env  ва quyidagilarni to'ldiring │
# │ DIQQAT: bu faylni hech kimga bermang, git'ga qo'shmang!      │
# └─────────────────────────────────────────────────────────────┘

# ── Smartup API ──
SMARTUP_BASE_URL=https://smartup.online
SMARTUP_USERNAME=
SMARTUP_PASSWORD=

# ── Telegram bot ──
TELEGRAM_BOT_TOKEN=

# ── Filtrlar ──
# Bir nechta qiymatni vergul bilan ajrating: masalan  a,b,c
TARGET_STATUSES=to delivered
# "Терминал" omborining KOD(lar)i (nom emas!):
EXCLUDE_WAREHOUSE_CODES=

# Tekshirish oralig'i (sekund). 600 = har 10 daqiqa
POLL_INTERVAL_SECONDS=600

# ── Gynomedix ──
GYNOMEDIX_PROJECT_CODE=
GYNOMEDIX_FILIAL_ID=
GYNOMEDIX_FILIAL_CODE=
GYNOMEDIX_CHAT_ID=
GYNOMEDIX_PRODUCER_CODES=
GYNOMEDIX_EXCLUDE_PRODUCER_CODES=

# ── BP Pharma ──
BP_PHARMA_PROJECT_CODE=
BP_PHARMA_FILIAL_ID=
BP_PHARMA_FILIAL_CODE=
BP_PHARMA_CHAT_ID=
BP_PHARMA_PRODUCER_CODES=
# Bromedix order'larini BP guruhiga olmaslik uchun uning producer kodi:
BP_PHARMA_EXCLUDE_PRODUCER_CODES=

# ── Bromedix (BP Pharma filialida turadi) ──
BROMEDIX_PROJECT_CODE=
BROMEDIX_FILIAL_ID=
# Bromedix'da o'z filial_code yo'q — BP Pharma'nikini yozing:
BROMEDIX_FILIAL_CODE=
BROMEDIX_CHAT_ID=
# Bromedix'ning ishlab chiqaruvchi kod(lar)i — faqat shular olinadi:
BROMEDIX_PRODUCER_CODES=
BROMEDIX_EXCLUDE_PRODUCER_CODES=
